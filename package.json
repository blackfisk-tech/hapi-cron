{
  "name": "@blackfisk/hapi-cron",
  "version": "1.1.0",
  "access": "private",
  "description": "A Hapi plugin to setup cron jobs that will call predefined server routes at specified times",
  "exports": "./lib/index.js",
  "scripts": {
    "test": "npm run eslint && NODE_OPTIONS=--experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "eslint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antonsamper/hapi-cron.git"
  },
  "keywords": [
    "hapi",
    "plugin",
    "cron"
  ],
  "author": "Anton Samper Rivaya",
  "type": "module",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/antonsamper/hapi-cron/issues"
  },
  "homepage": "https://github.com/antonsamper/hapi-cron#readme",
  "devDependencies": {
    "@hapi/eslint-plugin": "^7.0.0",
    "@hapi/hapi": "^21.4.0",
    "eslint": "^9.23.0",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "@babel/eslint-parser": "^7.27.0",
    "@hapi/hoek": "^11.0.7",
    "cron": "^4.1.3"
  },
  "engines": {
    "node": ">=22"
  },
  "jest": {
    "collectCoverage": true,
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    },
    "testEnvironment": "node"
  }
}
